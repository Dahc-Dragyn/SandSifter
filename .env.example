# Sandsifter Environment Configuration
# Copy this file to .env and configure your credentials.

# Google Gemini API Key (Required for semantic embeddings, OCR classifier, and The Hook Machine)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Platform Project ID (Optional: for Cloud Run deployment)
GCP_PROJECT_ID=your_gcp_project_id_here

# Server Port (Default: 8080)
PORT=8080

# Logging & Diagnostics
RUST_LOG=info
RUST_BACKTRACE=1
